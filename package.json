{
  "name": "@claperco/wordcloud.js",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Claper",
  "type": "module",
  "description": "A tiny responsive word cloud",
  "keywords": ["wordcloud", "word-cloud", "visualization", "vanilla-js", "browser"],
  "repository": { "type": "git", "url": "git+https://github.com/ClaperCo/wordcloud.js.git" },
  "homepage": "https://github.com/ClaperCo/wordcloud.js#readme",
  "bugs": { "url": "https://github.com/ClaperCo/wordcloud.js/issues" },
  "main": "./claper-wordcloud.js",
  "exports": "./claper-wordcloud.js",
  "sideEffects": false,
  "files": ["claper-wordcloud.js", "demo/index.html", "demo/assets", "CONTRIBUTING.md", "SECURITY.md"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "scripts": {
    "test": "node --test claper-wordcloud.test.js",
    "build:demo": "node demo/build.js",
    "check:demo": "node demo/build.js --check",
    "check": "node --check claper-wordcloud.js && node --check demo/words.js && node --check demo/build.js && npm run check:demo",
    "verify": "npm run check && npm test",
    "prepack": "npm run build:demo && npm run verify"
  }
}
